# Keep line endings predictable across Windows/Linux checkouts.
* text=auto eol=lf

# Windows launchers stay CRLF so cmd.exe and PowerShell are happy.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.zip binary

# The packaged release archive is generated by packaging/build-release.ps1.
dist/** -text
