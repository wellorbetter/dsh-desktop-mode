{
  "name": "dsh-plugin-desktop-mode",
  "version": "0.0.4",
  "description": "DSH 桌面模式：把 DSH 变成 Windows 桌面 —— 壁纸上方的时间/日期/手写文字/天气/fps 挂件层、在 DSH 设置里可调的挂件设置页，以及\"点输入框即可打字\"（原生工具负责离开/回到桌面层并接管键盘）。配套原生宿主包提供桌面层、图标、自启与托盘。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "desktop-mode",
    "widget",
    "wallpaper"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/settings-page.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "node --check lib/index.js && node --check lib/client.js && node --check lib/typing.js && node --check lib/settings-page.js && node --check lib/widgets/config.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellorbetter/dsh-desktop-mode.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/wellorbetter/dsh-desktop-mode#readme",
  "bugs": {
    "url": "https://github.com/wellorbetter/dsh-desktop-mode/issues"
  },
  "author": "wellorbetter",
  "license": "MIT"
}
